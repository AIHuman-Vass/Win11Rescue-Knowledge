{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIHuman-Vass/Win11Rescue-Knowledge/schemas/knowledge.schema.json",
  "title": "Win11Rescue Knowledge Pack v1",
  "type": "object",
  "required": ["schemaVersion", "version", "publishedUtc", "publisher", "publisherThumbprint", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "publishedUtc": { "type": "string", "format": "date-time" },
    "publisher": { "type": "string", "minLength": 1 },
    "publisherThumbprint": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "confidence", "conditions", "probableCause", "recommendation", "repairAction", "risk"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 96 },
          "title": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "severity": { "enum": ["info", "warning", "critical"] },
          "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["fact", "operator", "value"],
              "properties": {
                "fact": { "type": "string", "minLength": 1, "maxLength": 128 },
                "operator": { "enum": ["eq", "ne", "gt", "ge", "lt", "le", "contains", "matches"] },
                "value": {}
              },
              "additionalProperties": false
            }
          },
          "probableCause": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "recommendation": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "repairAction": { "enum": ["NONE", "BITLOCKER_UNLOCK", "BCD_REBUILD", "REVERT_PENDING_SERVICING", "STORAGE_DIAGNOSIS"] },
          "risk": { "enum": ["none", "low", "medium", "high"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
