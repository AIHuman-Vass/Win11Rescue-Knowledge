{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AIHuman-Vass/Win11Rescue-Knowledge/schemas/manifest.schema.json",
  "title": "Win11Rescue Knowledge Manifest",
  "type": "object",
  "required": ["schema_version", "pack_version", "channel", "knowledge_url", "signature_url", "sha256", "min_engine_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_version": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$" },
    "channel": { "enum": ["stable", "preview"] },
    "knowledge_url": { "type": "string", "format": "uri" },
    "signature_url": { "type": "string", "format": "uri" },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "min_engine_version": { "type": "string" },
    "max_engine_version": { "type": ["string", "null"] },
    "published_utc": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
